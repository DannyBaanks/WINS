#!/usr/bin/env python3
"""
WINS (WINS Is Not a Sandbox) - Unified CLI
De-layer and re-host Windows runtime-wrapped applications natively on Linux.
"""

import sys
import os
import argparse
import json
import subprocess

# Ensure core is on path
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO_ROOT)

from core.triage import BinaryTriage
from core.recipes.electron import ElectronRecipe
from core.recipes.pyinstaller import PyInstallerRecipe
from core.recipes.dotnet import DotNetRecipe
from core.recipes.transpiler import TranspilerRecipe
from core.tester import CleanroomTester
from core.transpiler.harvester import BinaryHarvester
from core.transpiler.fallout_pipeline import detect_fallout_nv, FalloutPipeline

RECIPES = [
    ElectronRecipe(),
    PyInstallerRecipe(),
    DotNetRecipe(),
    TranspilerRecipe(),
]

BANNER = r"""
 __      __ _____  _   _   _____ 
 \ \    / /|_   _|| \ | | / ____|
  \ \  / /   | |  |  \| || (___  
   \ \/ /    | |  | . ` | \___ \ 
    \  /    _| |_ | |\  | ____) |
     \/    |_____||_| \_||_____/ 
   WINS Is Not a Sandbox (v0.1.0)
   Post-Wine Desktop Software Re-hosting Framework
"""

def cmd_probe(args):
    triage = BinaryTriage(args.target).probe()
    if args.json:
        print(json.dumps(triage, indent=2))
        return

    print(f"\n[TARGET] {triage['target']['name']} ({triage['target']['size_human']})")
    print(f"  SHA-256:  {triage['target']['sha256']}")
    print(f"\n[ENVELOPE] {triage['envelope']['name']}")
    print(f"\n[DETECTED RUNTIME] {triage['runtime'].upper()}")
    for k, v in triage['runtime_details'].items():
        print(f"  {k}: {v}")
    print(f"\n[PORTING FEASIBILITY] {triage['feasibility']}")
    print(f"[RECOMMENDED RECIPE]  {triage['recommended_recipe']}\n")

def cmd_transmute(args):
    triage = BinaryTriage(args.target).probe()
    recipe_name = triage.get("recommended_recipe")

    matched_recipe = None
    for r in RECIPES:
        if r.can_handle(triage):
            matched_recipe = r
            break

    if not matched_recipe:
        print(f"[ERROR] No transmutation recipe found for runtime: {triage.get('runtime')}", file=sys.stderr)
        sys.exit(1)

    dest_dir = os.path.expanduser(args.dest) if args.dest else os.path.expanduser(f"~/.local/share/{triage['target']['name'].split('-')[0].lower()}-desktop")
    options = {
        "bin_dir": args.bin_dir,
        "electron_version": args.electron_version,
    }

    print(f"[WINS] Selected Recipe: {matched_recipe.name} ({matched_recipe.description})")
    success = matched_recipe.transmute(triage, dest_dir, options)
    if not success:
        print("[WINS] Transmutation failed.", file=sys.stderr)
        sys.exit(1)

def cmd_test(args):
    tester = CleanroomTester(args.target, timeout=args.timeout, headless=args.headless)
    report = tester.execute()
    if args.json:
        print(json.dumps(report, indent=2))
        return

    print(f"\n[WINS TEST REPORT] {report['target']}")
    print(f"  Status:    {report['status']}")
    print(f"  Duration:  {report['duration_seconds']}s (Timed out: {report['timed_out']}, Exit Code: {report['exit_code']})")
    print(f"  Summary:   {report['summary']}\n")

    if report["anomalies"]:
        print("[DETECTED ANOMALIES]")
        for an in report["anomalies"]:
            print(f"  - [{an['severity']}] {an['type']}: {an['detail']}")
        print("")

    print("[AGENT ACTIONABLE RECOMMENDATIONS]")
    for act in report["agent_actions"]:
        print(f"  -> {act}")
    print("")

def cmd_harvest(args):
    harvester = BinaryHarvester(args.target)
    report = harvester.harvest()
    if args.json:
        print(json.dumps(report, indent=2))
        return

    print(f"\n[TARGET PE] {report['binary']['name']} ({report['binary']['architecture']})")
    print(f"  Sections: {', '.join(report['binary']['sections'])}")
    print(f"\n[API DECOMPOSITION & TRANSPILABILITY]")
    print(f"  Total Imported DLLs:  {report['metrics']['total_imported_dlls']}")
    print(f"  Total Imported APIs:  {report['metrics']['total_imported_apis']}")
    print(f"  POSIX Mappable APIs:  {report['metrics']['posix_mappable_apis']} ({report['metrics']['posix_transpilability_score']})")
    print(f"  GUI/Windowing APIs:   {report['metrics']['gui_windowing_apis']}")

    if report["embedded_libraries"]:
        print(f"\n[DISCOVERED EMBEDDED OPEN-SOURCE ENGINES]")
        for lib in report["embedded_libraries"]:
            print(f"  * {lib['name']}")
            print(f"    Role: {lib['role']}")
            print(f"    Evidence: {', '.join(lib['evidence_samples'])}")
            print(f"    Linux Native Candidates:")
            for cand in lib["linux_candidates"]:
                print(f"      - {cand['package']}: {cand['description']}")

    print(f"\n[RTTI REVERSE-ENGINEERED CLASSES]")
    print(f"  Total Discovered Classes: {report['rtti_classes_count']}")
    if report["rtti_classes_sample"]:
        print(f"  Sample: {', '.join(report['rtti_classes_sample'][:10])}...")

    print(f"\n[TOP IMPORTED API DOMAINS]")
    for domain, data in sorted(report["api_domains"].items(), key=lambda x: x[1]["api_count"], reverse=True)[:6]:
        flag = "[POSIX MAPPABLE]" if data["transpilable_to_posix"] else "[REQUIRES UI ADAPTER]"
        print(f"  - {domain}: {data['api_count']} APIs {flag} -> {data['linux_equivalent']}")
    print("")

def cmd_fuzz(args):
    fuzzer_bin = os.path.join(REPO_ROOT, "bin", "wins-fuzz")
    if not os.path.isfile(fuzzer_bin) or not os.access(fuzzer_bin, os.X_OK):
        print(f"[WINS] Compiling Zig differential fuzzer engine...", file=sys.stderr)
        build_cmd = ["zig", "build-exe", "-O", "ReleaseFast", "core/fuzzer/src/main.zig", f"-femit-bin={fuzzer_bin}"]
        res = subprocess.run(build_cmd, cwd=REPO_ROOT)
        if res.returncode != 0:
            print("[ERROR] Failed to compile Zig differential fuzzer.", file=sys.stderr)
            sys.exit(1)

    cmd = [fuzzer_bin, "--suite", args.suite, "--iterations", str(args.iterations)]
    if args.json:
        cmd.append("--json")

    subprocess.run(cmd)

def cmd_compile_fuzz(args):
    print("[ERROR] Legacy compile-fuzz disabled: it invokes generated shims in-process and does not validate a PE port. See GUIA.md for the isolated Zig workflow.", file=sys.stderr)
    sys.exit(1)

def cmd_corpus_attack(args):
    fuzzer_bin = os.path.join(REPO_ROOT, "build", "wins-corpus-fuzzer")
    if not os.path.isfile(fuzzer_bin) or not os.access(fuzzer_bin, os.X_OK):
        os.makedirs(os.path.dirname(fuzzer_bin), exist_ok=True)
        print("[WINS] Compiling Zig 0.16 corpus fuzzer (native/wins_fuzzer.zig)...", file=sys.stderr)
        build_cmd = [
            "zig", "build-exe", "native/wins_fuzzer.zig",
            "-O", "ReleaseSafe", "-lc", "-lX11",
            f"-femit-bin={fuzzer_bin}",
        ]
        res = subprocess.run(build_cmd, cwd=REPO_ROOT)
        if res.returncode != 0:
            print("[ERROR] Failed to compile Zig corpus fuzzer.", file=sys.stderr)
            sys.exit(1)

    corpus_dir = args.corpus or os.path.join(REPO_ROOT, "corpus")
    cmd = [fuzzer_bin, "--corpus", corpus_dir]
    if args.json:
        cmd.append("--json")
    res = subprocess.run(cmd, cwd=REPO_ROOT)
    if res.returncode != 0:
        sys.exit(res.returncode)


def cmd_fallout(args):
    install = detect_fallout_nv(args.path)
    if not install:
        print(f"[ERROR] Could not locate FalloutNV.esm at: {args.path}", file=sys.stderr)
        sys.exit(1)

    pipe = FalloutPipeline(install)
    if args.audit or args.json:
        stats = pipe.audit()
        print(json.dumps(stats, indent=2))
        return

    if args.openmw_cfg:
        cfg = pipe.generate_openmw_config(args.openmw_cfg)
        print(f"[WINS] Generated native OpenMW config at {args.openmw_cfg}")
        print(cfg)
        return

    # Default summary
    stats = pipe.audit()
    print(f"\n[WINS: FALLOUT NEW VEGAS NATIVE ASSET ENGINE]")
    print(f"  Master File:     {stats['esm']['file']} ({stats['esm']['size_mb']} MB, {stats['esm']['top_groups']} top groups)")
    print(f"  Worldspaces:     {stats['esm']['worldspaces_count']} worlds (Mojave Wasteland, Freeside, The Strip, Lucky 38...)")
    print(f"  Static 3D Meshes:{stats['esm']['static_meshes_count']} models")
    print(f"  BSA Archives:    {len(stats['bsas'])} indexed archives ({sum(b['file_count'] for b in stats['bsas'].values() if 'file_count' in b)} total assets)")
    print(f"  D3D9 Shaders:    {stats['shaders']['total_compiled_shaders']} compiled bytecode shaders across {stats['shaders']['packages_count']} packages")
    print("")

def cmd_list(args):
    print("\nAvailable WINS Transmutation Recipes:")
    for r in RECIPES:
        print(f"  - {r.name.ljust(15)} : {r.description}")
    print("")

def main():
    parser = argparse.ArgumentParser(description="WINS - Re-host Windows apps natively on Linux.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # probe
    p_probe = subparsers.add_parser("probe", help="Inspect and classify binary taxonomy")
    p_probe.add_argument("target", help="Path to Windows .exe")
    p_probe.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_probe.set_defaults(func=cmd_probe)

    # transmute
    p_trans = subparsers.add_parser("transmute", help="Execute de-layering and native re-hosting")
    p_trans.add_argument("target", help="Path to Windows .exe")
    p_trans.add_argument("--dest", "--out", dest="dest", help="Destination directory (default: ~/.local/share/<app>-desktop)")
    p_trans.add_argument("--bin-dir", default="~/.local/bin", help="Launcher bin directory")
    p_trans.add_argument("--electron-version", default="35.1.4", help="Target Electron runtime version")
    p_trans.set_defaults(func=cmd_transmute)

    # test
    p_test = subparsers.add_parser("test", help="Execute black-box cleanroom test and diagnose anomalies")
    p_test.add_argument("target", help="Path to launcher executable, directory, or app name (e.g. notion)")
    p_test.add_argument("--timeout", type=float, default=5.0, help="Test execution timeout in seconds (default: 5.0)")
    p_test.add_argument("--headless", action="store_true", help="Run under xvfb virtual display if available")
    p_test.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_test.set_defaults(func=cmd_test)

    # harvest
    p_harvest = subparsers.add_parser("harvest", help="Extract IAT, demangle RTTI, and discover Linux candidates for PE binary")
    p_harvest.add_argument("target", help="Path to Windows PE .exe")
    p_harvest.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_harvest.set_defaults(func=cmd_harvest)

    # fuzz
    p_fuzz = subparsers.add_parser("fuzz", help="Run high-performance Zig differential fuzzer on API candidate shims")
    p_fuzz.add_argument("--suite", default="all", choices=["all", "path", "encoding", "registry", "pixel", "security", "buffer"], help="Differential test suite")
    p_fuzz.add_argument("--iterations", type=int, default=100000, help="Fuzz iterations count (default: 100000)")
    p_fuzz.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_fuzz.set_defaults(func=cmd_fuzz)

    # compile-fuzz
    p_compile_fuzz = subparsers.add_parser("compile-fuzz", help="Run autonomous E2E compilation & shim synthesis fuzzer")
    p_compile_fuzz.add_argument("target", help="Path to Windows PE .exe")
    p_compile_fuzz.add_argument("--out", help="Path to output compiled .so (default: temporary/app specific)")
    p_compile_fuzz.add_argument("--max-rounds", type=int, default=30, help="Maximum mutation and compilation iterations (default: 30)")
    p_compile_fuzz.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_compile_fuzz.set_defaults(func=cmd_compile_fuzz)

    # corpus-attack
    p_corpus = subparsers.add_parser("corpus-attack", aliases=["corpus-fuzz"], help="Attack PE corpus with loader verification and Pareto missing-API ranking")
    p_corpus.add_argument("--corpus", help="Path to corpus directory (default: <repo>/corpus)")
    p_corpus.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_corpus.set_defaults(func=cmd_corpus_attack)

    # fallout
    p_fallout = subparsers.add_parser("fallout", help="Inspect and stage Fallout New Vegas assets natively (Zero Wine)")
    p_fallout.add_argument("path", help="Path to Fallout New Vegas root or Data folder")
    p_fallout.add_argument("--audit", action="store_true", help="Output full JSON audit")
    p_fallout.add_argument("--openmw-cfg", help="Path to generate openmw.cfg")
    p_fallout.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_fallout.set_defaults(func=cmd_fallout)

    # list
    p_list = subparsers.add_parser("list", help="List available transmutation recipes")
    p_list.set_defaults(func=cmd_list)

    if len(sys.argv) == 1:
        print(BANNER)
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
