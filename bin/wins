#!/usr/bin/env python3
"""
WINS (WINS Is Not a Sandbox) - Unified CLI
De-layer and re-host Windows runtime-wrapped applications natively on Linux.
"""

import sys
import os
import argparse
import json
import threading

# Ensure core is on path
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO_ROOT)

from core.triage import BinaryTriage
from core.recipes.electron import ElectronRecipe
from core.recipes.pyinstaller import PyInstallerRecipe
from core.recipes.dotnet import DotNetRecipe
from core.tester import CleanroomTester
from core.healers.companion_binaries import CompanionBinaryHealer
from core.port_context import PortContext
from core.local_addon import LocalAddonProject, MetaServer, sync_local_addon, discover_control_port

RECIPES = [
    ElectronRecipe(),
    PyInstallerRecipe(),
    DotNetRecipe(),
]

BANNER = r"""
 __      __ _____  _   _   _____ 
 \ \    / /|_   _|| \ | | / ____|
  \ \  / /   | |  |  \| || (___  
   \ \/ /    | |  | . ` | \___ \ 
    \  /    _| |_ | |\  | ____) |
     \/    |_____||_| \_||_____/ 
   WINS Is Not a Sandbox (v0.1.0)
   Post-Wine Desktop Software Re-hosting Framework
"""

def cmd_probe(args):
    triage = BinaryTriage(args.target).probe()
    if args.json:
        print(json.dumps(triage, indent=2))
        return

    print(f"\n[TARGET] {triage['target']['name']} ({triage['target']['size_human']})")
    print(f"  SHA-256:  {triage['target']['sha256']}")
    print(f"\n[ENVELOPE] {triage['envelope']['name']}")
    print(f"\n[DETECTED RUNTIME] {triage['runtime'].upper()}")
    for k, v in triage['runtime_details'].items():
        print(f"  {k}: {v}")
    print(f"\n[PORTING FEASIBILITY] {triage['feasibility']}")
    print(f"[RECOMMENDED RECIPE]  {triage['recommended_recipe']}\n")

def cmd_transmute(args):
    triage = BinaryTriage(args.target).probe()
    recipe_name = triage.get("recommended_recipe")

    matched_recipe = None
    for r in RECIPES:
        if r.can_handle(triage):
            matched_recipe = r
            break

    if not matched_recipe:
        print(f"[ERROR] No transmutation recipe found for runtime: {triage.get('runtime')}", file=sys.stderr)
        sys.exit(1)

    dest_dir = os.path.expanduser(args.dest) if args.dest else os.path.expanduser(f"~/.local/share/{triage['target']['name'].split('-')[0].lower()}-desktop")
    options = {
        "bin_dir": args.bin_dir,
        "electron_version": args.electron_version,
        "app_id": args.app_id,
        "arch": args.arch,
        "allow_wine_fallback": not args.no_wine_fallback,
        "skills_dir": args.skills_dir,
        "workspace": args.workspace,
    }

    print(f"[WINS] Selected Recipe: {matched_recipe.name} ({matched_recipe.description})")
    success = matched_recipe.transmute(triage, dest_dir, options)
    if not success:
        print("[WINS] Transmutation failed.", file=sys.stderr)
        sys.exit(1)

def cmd_test(args):
    tester = CleanroomTester(args.target, timeout=args.timeout, headless=args.headless)
    report = tester.execute()
    if args.json:
        print(json.dumps(report, indent=2))
        return

    print(f"\n[WINS TEST REPORT] {report['target']}")
    print(f"  Status:    {report['status']}")
    print(f"  Duration:  {report['duration_seconds']}s (Timed out: {report['timed_out']}, Exit Code: {report['exit_code']})")
    print(f"  Summary:   {report['summary']}\n")

    if report["anomalies"]:
        print("[DETECTED ANOMALIES]")
        for an in report["anomalies"]:
            print(f"  - [{an['severity']}] {an['type']}: {an['detail']}")
        print("")

    print("[AGENT ACTIONABLE RECOMMENDATIONS]")
    for act in report["agent_actions"]:
        print(f"  -> {act}")
    print("")

def cmd_heal_bin(args):
    """Heals Windows-only companion executables of an (already transmuted) app."""
    healer = CompanionBinaryHealer(arch=args.arch)
    report = healer.heal(
        args.target,
        app_id=args.app_id,
        allow_wine_fallback=not args.no_wine_fallback,
        dry_run=args.dry_run,
    )
    if args.json:
        print(json.dumps(report, indent=2))
        return

    print(f"\n[WINS COMPANION HEAL] {report['target']}")
    print(f"  Bin dir:      {report['bin_dir']}")
    print(f"  PE helpers:   {report['scanned']}")
    print(f"  Native ELF:   {len(report['healed_native'])}")
    print(f"  Micro-Wine:   {len(report['wine_shimmed'])}")
    print(f"  Already ELF:  {len(report['already_native'])}\n")
    for item in report["healed_native"]:
        print(f"  - [native] {item['name']} <- {item['source']}")
    for item in report["wine_shimmed"]:
        print(f"  - [shim]   {item['name']} -> {item['path']}")
    for err in report["errors"]:
        print(f"  - [error]  {err}")
    print("")

def cmd_port_context(args):
    """Generates the agent-facing host corpus of a transmuted (ported) app."""
    context = PortContext(
        app_id=args.app_id,
        app_title=args.title,
        install_dir=args.install_dir,
        skills_dir=args.skills_dir,
        workspace=args.workspace,
        slug=args.slug,
    )
    report = context.install(print_preamble=not args.json)
    if args.json:
        print(json.dumps(report, indent=2))
        return

    print(f"\n[WINS PORT CONTEXT] {report['app_id']}")
    print(f"  Skill:         {report['skill'] or '(not installed)'}")
    print(f"  Workspace doc: {report['workspace_doc'] or '(not installed)'}")
    print(f"\n  Preamble for the agent chat:\n")
    for line in report["preamble"].split(". "):
        print(f"    - {line.strip()}")
    print("")

def cmd_local_addon(args):
    """Publishes the port context as a native local addon (skill catalog)."""
    context = PortContext(
        app_id=args.app_id,
        app_title=args.title,
        install_dir=args.install_dir,
        slug=args.slug,
    )
    addon_root = os.path.expanduser(args.addon_root)
    project = LocalAddonProject(addon_root=addon_root, addon_id=args.addon_id,
                                slug=args.slug, display_name=args.title or args.addon_id)
    server = MetaServer(project, port=args.port)
    meta_port = server.start()
    written = project.write(context.render_skill(), meta_port, corpus_body=context.render())

    if not args.json:
        print(f"\n[WINS LOCAL ADDON] {written['addon_id']}")
        print(f"  Source dir: {written['source_dir']}")
        print(f"  Meta URL:   {written['meta_url']}")
        print(f"  Skill:      {written['skill_path']}")

    sync_result = None
    if args.sync:
        control_port = discover_control_port(args.log_dir, args.control_name)
        unix_sock = os.path.expanduser(args.unix_socket) if args.unix_socket else None
        if unix_sock and os.path.exists(unix_sock):
            sync_result = sync_local_addon(args.addon_id, unix_socket_path=unix_sock)
        elif control_port:
            sync_result = sync_local_addon(args.addon_id, control_port=control_port)
        else:
            message = ("No operator local API reachable "
                       "(start the operator with the WINS bridge or pass --unix-socket).")
            if not args.json:
                print(f"[WINS:LOCALADDON] {message}")
            sync_result = {"error": {"message": message}}
    if sync_result is not None and not args.json:
        error = (sync_result.get("error") or {})
        data = (error.get("data") or {})
        print(f"  Sync:       {error.get('message') or 'ok'}")
        for diag in (data.get("diagnostics") or []):
            print(f"    - {diag.get('code')}: {diag.get('summary')}")
            excerpt = diag.get("log_excerpt")
            if excerpt:
                print(f"      {excerpt[:500]}")

    if not args.keep_serving:
        server.stop()
    else:
        print(f"  Serving meta on 127.0.0.1:{meta_port} (Ctrl+C to stop)")
        try:
            while True:
                threading.Event().wait(3600)
        except KeyboardInterrupt:
            server.stop()

    if args.json:
        print(json.dumps({"written": written, "sync": sync_result}, indent=2))

def cmd_list(args):
    print("\nAvailable WINS Transmutation Recipes:")
    for r in RECIPES:
        print(f"  - {r.name.ljust(15)} : {r.description}")
    print("")

def main():
    parser = argparse.ArgumentParser(description="WINS - Re-host Windows apps natively on Linux.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # probe
    p_probe = subparsers.add_parser("probe", help="Inspect and classify binary taxonomy")
    p_probe.add_argument("target", help="Path to Windows .exe")
    p_probe.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_probe.set_defaults(func=cmd_probe)

    # transmute
    p_trans = subparsers.add_parser("transmute", help="Execute de-layering and native re-hosting")
    p_trans.add_argument("target", help="Path to Windows .exe")
    p_trans.add_argument("--dest", "--out", dest="dest", help="Destination directory (default: ~/.local/share/<app>-desktop)")
    p_trans.add_argument("--bin-dir", default="~/.local/bin", help="Launcher bin directory")
    p_trans.add_argument("--electron-version", default="35.1.4", help="Target Electron runtime version")
    p_trans.add_argument("--app-id", default=None, help="Application id used to resolve native Linux companion builds")
    p_trans.add_argument("--arch", default="x64", help="Target architecture for native builds (default: x64)")
    p_trans.add_argument("--no-wine-fallback", action="store_true", help="Do not generate micro-Wine shims for PE companions")
    p_trans.add_argument("--skills-dir", default=None, help="Skill directory for the generated host corpus SKILL.md")
    p_trans.add_argument("--workspace", default=None, help="Workspace directory for the generated host corpus")
    p_trans.set_defaults(func=cmd_transmute)

    # test
    p_test = subparsers.add_parser("test", help="Execute black-box cleanroom test and diagnose anomalies")
    p_test.add_argument("target", help="Path to launcher executable, directory, or app name (e.g. notion)")
    p_test.add_argument("--timeout", type=float, default=5.0, help="Test execution timeout in seconds (default: 5.0)")
    p_test.add_argument("--headless", action="store_true", help="Run under xvfb virtual display if available")
    p_test.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_test.set_defaults(func=cmd_test)

    # list
    p_list = subparsers.add_parser("list", help="List available transmutation recipes")
    p_list.set_defaults(func=cmd_list)

    # heal-bin
    p_heal = subparsers.add_parser(
        "heal-bin",
        help="Heal Windows-only companion executables of an installed app (native ELF first, micro-Wine shim otherwise)",
    )
    p_heal.add_argument("target", help="App install dir, resources dir or bin dir containing the companion .exe files")
    p_heal.add_argument("--app-id", default=None, help="Application id used to resolve native Linux builds (manifest lookup)")
    p_heal.add_argument("--arch", default="x64", help="Target architecture for native builds (default: x64)")
    p_heal.add_argument("--no-wine-fallback", action="store_true", help="Fail instead of generating a micro-Wine shim")
    p_heal.add_argument("--dry-run", action="store_true", help="Report what would be done without writing")
    p_heal.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_heal.set_defaults(func=cmd_heal_bin)

    # port-context
    p_ctx = subparsers.add_parser(
        "port-context",
        help="Generate the agent-facing host corpus (AGENTS/skill + command corpus) of a ported app",
    )
    p_ctx.add_argument("--app-id", required=True, help="Application id (e.g. manus)")
    p_ctx.add_argument("--title", default=None, help="Human readable application title")
    p_ctx.add_argument("--install-dir", default=None, help="Ported application install directory")
    p_ctx.add_argument("--skills-dir", default=None, help="Skill directory to install the SKILL.md into")
    p_ctx.add_argument("--workspace", default=None, help="Workspace directory to drop AGENTS.md / WINS-PORT.md into")
    p_ctx.add_argument("--slug", default="wins-port-context", help="Skill slug (default: wins-port-context)")
    p_ctx.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_ctx.set_defaults(func=cmd_port_context)

    # local-addon
    p_la = subparsers.add_parser(
        "local-addon",
        help="Publish the port context as a native local addon (meta server + operator sync)",
    )
    p_la.add_argument("--app-id", required=True, help="Application id (e.g. manus)")
    p_la.add_argument("--title", default=None, help="Human readable addon title")
    p_la.add_argument("--install-dir", default=None, help="Ported application install directory")
    p_la.add_argument("--addon-id", default="desktop-local-wins-port-context", help="Local addon id")
    p_la.add_argument("--addon-root", default="~/.config/Manus/operator-addons", help="Operator addon root")
    p_la.add_argument("--slug", default="wins-port-context", help="Skill slug inside the addon")
    p_la.add_argument("--port", type=int, default=0, help="Meta server port (0 = ephemeral)")
    p_la.add_argument("--sync", action="store_true", help="Ask the operator to sync the addon (addon.local.sync)")
    p_la.add_argument("--unix-socket", default=None, help="Operator local API unix socket (native Linux operators)")
    p_la.add_argument("--log-dir", default="~/.cache/wins/logs", help="Directory holding the bridge control port file")
    p_la.add_argument("--control-name", default="manus-computer-operator", help="Bridge name used for the control port file")
    p_la.add_argument("--keep-serving", action="store_true", help="Keep the meta server running after the sync")
    p_la.add_argument("--json", action="store_true", help="Output machine-readable JSON for agents")
    p_la.set_defaults(func=cmd_local_addon)

    if len(sys.argv) == 1:
        print(BANNER)
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
